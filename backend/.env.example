# =============================================
# BOLÃO COPA 2026 — Configuração
# Copie este arquivo para .env e preencha
# =============================================

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/bolao_copa2026

# JWT — segredo forte, gere com: openssl rand -hex 64   (obrigatório)
JWT_SECRET=substitua_por_um_segredo_muito_longo_e_aleatorio

# Tempo de expiração do token (ex: 7d, 24h)
JWT_EXPIRES_IN=7d

# Porta do servidor
PORT=3001

# Fechar apostas X minutos antes do jogo
BET_CLOSE_MINUTES=5

# Ambiente: development | production
NODE_ENV=development

# Origens permitidas pelo CORS (frontend), separadas por vírgula
CORS_ORIGINS=http://localhost:3001,https://seu-frontend.vercel.app

# (Opcional) Chave RapidAPI/API-Football para buscar placares automaticamente.
# Sem ela, o cron só fecha apostas e os placares são registrados à mão no painel.
RAPIDAPI_KEY=
